{
  "name": "vscode-npu-monitor",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.3.0",
  "publisher": "local",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/li1how/vscode-npu-monitor.git"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "files": [
    "dist/extension.js",
    "media/",
    "l10n/",
    "package.nls.json",
    "package.nls.zh-cn.json",
    "README.md",
    "README.zh-CN.md",
    "CONTRIBUTING.md",
    "CONTRIBUTING.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:npuMonitor.hosts"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "npuMonitor",
          "title": "%view.container%",
          "icon": "media/npu-monitor.svg"
        }
      ]
    },
    "views": {
      "npuMonitor": [
        {
          "id": "npuMonitor.hosts",
          "name": "%view.hosts%",
          "contextualTitle": "%view.container%"
        }
      ]
    },
    "commands": [
      {
        "command": "npuMonitor.scanAll",
        "title": "%command.scanAll%",
        "icon": "$(refresh)"
      },
      {
        "command": "npuMonitor.reloadConfig",
        "title": "%command.reloadConfig%",
        "icon": "$(server-process)"
      },
      {
        "command": "npuMonitor.scanHost",
        "title": "%command.scanHost%",
        "icon": "$(refresh)"
      },
      {
        "command": "npuMonitor.scanSelected",
        "title": "%command.scanSelected%",
        "icon": "$(refresh)"
      },
      {
        "command": "npuMonitor.showIdleHistory",
        "title": "%command.showIdleHistory%",
        "icon": "$(history)"
      },
      {
        "command": "npuMonitor.subscribeHost",
        "title": "%command.subscribe%",
        "icon": "$(bell)"
      },
      {
        "command": "npuMonitor.unsubscribeHost",
        "title": "%command.unsubscribe%",
        "icon": "$(bell-slash)"
      },
      {
        "command": "npuMonitor.openSshTerminal",
        "title": "%command.openSshTerminal%",
        "icon": "$(terminal)"
      },
      {
        "command": "npuMonitor.selectSshConfig",
        "title": "%command.selectSshConfig%"
      },
      {
        "command": "npuMonitor.openSettings",
        "title": "%command.openSettings%",
        "icon": "$(settings-gear)"
      },
      {
        "command": "npuMonitor.showOutput",
        "title": "%command.showOutput%",
        "icon": "$(output)"
      },
      {
        "command": "npuMonitor.openDevContainer",
        "title": "%command.openDevContainer%",
        "icon": "$(empty-window)"
      },
      {
        "command": "npuMonitor.openSshWindow",
        "title": "%command.openSshWindow%",
        "icon": "$(window)"
      },
      {
        "command": "npuMonitor.copyHostInfo",
        "title": "%command.copyHostInfo%",
        "icon": "$(copy)"
      },
      {
        "command": "npuMonitor.copyContainerInfo",
        "title": "%command.copyContainerInfo%",
        "icon": "$(copy)"
      },
      {
        "command": "npuMonitor.copyContainerSummary",
        "title": "%command.copyContainerSummary%",
        "icon": "$(copy)"
      },
      {
        "command": "npuMonitor.mcpMenu",
        "title": "%command.mcpMenu%",
        "icon": "$(plug)"
      },
      {
        "command": "npuMonitor.findHost",
        "title": "%command.findHost%",
        "icon": "$(search)"
      },
      {
        "command": "npuMonitor.filterHosts",
        "title": "%command.filterHosts%",
        "icon": "$(filter)"
      },
      {
        "command": "npuMonitor.clearHostFilter",
        "title": "%command.clearHostFilter%",
        "icon": "$(clear-all)"
      },
      {
        "command": "npuMonitor.favoriteHost",
        "title": "%command.favoriteHost%",
        "icon": "$(star)"
      },
      {
        "command": "npuMonitor.unfavoriteHost",
        "title": "%command.unfavoriteHost%",
        "icon": "$(star-full)"
      },
      {
        "command": "npuMonitor.editHostNote",
        "title": "%command.editHostNote%",
        "icon": "$(edit)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "npuMonitor.scanAll",
          "when": "view == npuMonitor.hosts",
          "group": "navigation@1"
        },
        {
          "command": "npuMonitor.reloadConfig",
          "when": "view == npuMonitor.hosts",
          "group": "2_actions@3"
        },
        {
          "command": "npuMonitor.openSettings",
          "when": "view == npuMonitor.hosts",
          "group": "2_actions@5"
        },
        {
          "command": "npuMonitor.scanSelected",
          "when": "view == npuMonitor.hosts",
          "group": "2_actions@1"
        },
        {
          "command": "npuMonitor.selectSshConfig",
          "when": "view == npuMonitor.hosts",
          "group": "2_actions@2"
        },
        {
          "command": "npuMonitor.showOutput",
          "when": "view == npuMonitor.hosts",
          "group": "2_actions@4"
        },
        {
          "command": "npuMonitor.findHost",
          "when": "view == npuMonitor.hosts",
          "group": "navigation@2"
        },
        {
          "command": "npuMonitor.filterHosts",
          "when": "view == npuMonitor.hosts",
          "group": "navigation@3"
        },
        {
          "command": "npuMonitor.clearHostFilter",
          "when": "view == npuMonitor.hosts && npuMonitor.hostFilterActive",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "npuMonitor.scanHost",
          "when": "view == npuMonitor.hosts && viewItem =~ /^npuHost/",
          "group": "inline@1"
        },
        {
          "command": "npuMonitor.subscribeHost",
          "when": "view == npuMonitor.hosts && viewItem =~ /^npuHostUnsubscribed/",
          "group": "inline@2"
        },
        {
          "command": "npuMonitor.unsubscribeHost",
          "when": "view == npuMonitor.hosts && viewItem =~ /^npuHostSubscribed/",
          "group": "inline@2"
        },
        {
          "command": "npuMonitor.openSshTerminal",
          "when": "view == npuMonitor.hosts && viewItem =~ /^npuHost/",
          "group": "2_open@2"
        },
        {
          "command": "npuMonitor.scanSelected",
          "when": "view == npuMonitor.hosts && viewItem =~ /^npuHost/",
          "group": "1_scan@1"
        },
        {
          "command": "npuMonitor.openDevContainer",
          "when": "view == npuMonitor.hosts && viewItem == npuDevContainerRunning",
          "group": "inline@1"
        },
        {
          "command": "npuMonitor.openSshWindow",
          "when": "view == npuMonitor.hosts && viewItem =~ /^(npuHost|npuDevContainer)/",
          "group": "2_open@1"
        },
        {
          "command": "npuMonitor.copyHostInfo",
          "when": "view == npuMonitor.hosts && viewItem =~ /^npuHost/",
          "group": "3_copy@1"
        },
        {
          "command": "npuMonitor.copyContainerSummary",
          "when": "view == npuMonitor.hosts && viewItem =~ /^npuDevContainer/",
          "group": "inline@2"
        },
        {
          "command": "npuMonitor.copyContainerInfo",
          "when": "view == npuMonitor.hosts && viewItem =~ /^npuDevContainer/",
          "group": "3_copy@1"
        },
        {
          "command": "npuMonitor.showIdleHistory",
          "when": "view == npuMonitor.hosts && viewItem =~ /^npuHost/",
          "group": "inline@3"
        },
        {
          "command": "npuMonitor.favoriteHost",
          "when": "view == npuMonitor.hosts && viewItem =~ /^npuHost(Subscribed|Unsubscribed)$/",
          "group": "3_manage@1"
        },
        {
          "command": "npuMonitor.unfavoriteHost",
          "when": "view == npuMonitor.hosts && viewItem =~ /^npuHost/ && viewItem =~ /Favorite$/",
          "group": "3_manage@1"
        },
        {
          "command": "npuMonitor.editHostNote",
          "when": "view == npuMonitor.hosts && viewItem =~ /^npuHost/",
          "group": "3_manage@2"
        }
      ],
      "commandPalette": [
        {
          "command": "npuMonitor.openDevContainer",
          "when": "false"
        },
        {
          "command": "npuMonitor.openSshWindow",
          "when": "false"
        },
        {
          "command": "npuMonitor.editHostNote",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "npuMonitor.sshConfigPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "%configuration.sshConfigPath%"
        },
        "npuMonitor.knownHostsPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "%configuration.knownHostsPath%"
        },
        "npuMonitor.sshExecutablePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "%configuration.sshExecutablePath%"
        },
        "npuMonitor.connectTimeoutSeconds": {
          "type": "number",
          "default": 8,
          "minimum": 1,
          "maximum": 60,
          "scope": "window",
          "description": "%configuration.connectTimeoutSeconds%"
        },
        "npuMonitor.exporterProbeTimeoutSeconds": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 10,
          "scope": "window",
          "description": "%configuration.exporterProbeTimeoutSeconds%"
        },
        "npuMonitor.npuSmiTimeoutSeconds": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "maximum": 60,
          "scope": "window",
          "description": "%configuration.npuSmiTimeoutSeconds%"
        },
        "npuMonitor.maxConcurrentHosts": {
          "type": "number",
          "default": 8,
          "minimum": 1,
          "maximum": 32,
          "scope": "window",
          "description": "%configuration.maxConcurrentHosts%"
        },
        "npuMonitor.excludedHosts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "window",
          "description": "%configuration.excludedHosts%"
        },
        "npuMonitor.pollIntervalSeconds": {
          "type": "number",
          "default": 180,
          "minimum": 10,
          "maximum": 86400,
          "scope": "window",
          "description": "%configuration.pollIntervalSeconds%"
        },
        "npuMonitor.idleScope": {
          "type": "string",
          "enum": [
            "allCards",
            "anyCard"
          ],
          "enumDescriptions": [
            "%configuration.idleScope.allCards%",
            "%configuration.idleScope.anyCard%"
          ],
          "default": "anyCard",
          "scope": "window",
          "description": "%configuration.idleScope%"
        },
        "npuMonitor.idleRequireNoProcesses": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "%configuration.idleRequireNoProcesses%"
        },
        "npuMonitor.idleUtilizationThresholdPercent": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "maximum": 100,
          "scope": "window",
          "description": "%configuration.idleUtilizationThresholdPercent%"
        },
        "npuMonitor.idleConsecutiveChecks": {
          "type": "number",
          "default": 1,
          "minimum": 1,
          "maximum": 20,
          "scope": "window",
          "description": "%configuration.idleConsecutiveChecks%"
        },
        "npuMonitor.devContainers.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "%configuration.devContainers.enabled%"
        },
        "npuMonitor.devContainers.timeoutSeconds": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 60,
          "scope": "window",
          "description": "%configuration.devContainers.timeoutSeconds%"
        },
        "npuMonitor.containers.filterMode": {
          "type": "string",
          "enum": [
            "all",
            "devContainers",
            "workspacePaths"
          ],
          "enumDescriptions": [
            "%configuration.containers.filterMode.all%",
            "%configuration.containers.filterMode.devContainers%",
            "%configuration.containers.filterMode.workspacePaths%"
          ],
          "default": "devContainers",
          "scope": "window",
          "description": "%configuration.containers.filterMode%"
        },
        "npuMonitor.containers.workspacePaths": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^/[^\\u0000]*$"
          },
          "default": [],
          "scope": "window",
          "description": "%configuration.containers.workspacePaths%"
        },
        "npuMonitor.containers.workspaceFile": {
          "type": "string",
          "default": "",
          "pattern": "^\\s*(?:[^/\\\\\\u0000]+\\.code-workspace)?\\s*$",
          "scope": "window",
          "description": "%configuration.containers.workspaceFile%"
        },
        "npuMonitor.mcp.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "description": "%configuration.mcp.enabled%"
        },
        "npuMonitor.mcp.port": {
          "type": "integer",
          "default": 49160,
          "minimum": 1024,
          "maximum": 65535,
          "scope": "window",
          "description": "%configuration.mcp.port%"
        },
        "npuMonitor.autoRefreshAllHosts": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "%configuration.autoRefreshAllHosts%"
        },
        "npuMonitor.idleHistoryRetentionDays": {
          "type": "integer",
          "default": 7,
          "minimum": 1,
          "maximum": 30,
          "scope": "window",
          "description": "%configuration.idleHistoryRetentionDays%"
        }
      }
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "lint": "eslint src test scripts esbuild.mjs vitest.config.mts --no-error-on-unmatched-pattern",
    "test": "vitest run",
    "compile": "npm run check-types && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "check": "npm run check-types && npm run lint && npm test",
    "package": "npm run check && node esbuild.mjs --production",
    "vscode:prepublish": "npm run package",
    "vsix": "node scripts/package-vsix.mjs",
    "docs:capture": "node scripts/capture-readme.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ssh-config": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.43",
    "@types/vscode": "1.100.0",
    "@vscode/test-electron": "2.5.2",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "playwright": "1.65.0",
    "sharp": "0.35.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "minimatch": "11.0.5",
    "glob": "14.0.4"
  }
}
